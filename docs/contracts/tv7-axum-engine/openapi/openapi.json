{
  "openapi": "3.1.0",
  "info": {
    "title": "TV7 Axum Engine Local API",
    "version": "0.1.0",
    "description": "Local-only engine sidecar API exposed on loopback."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7070",
      "description": "Default local sidecar address"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/media/probe": {
      "post": {
        "summary": "Probe local media metadata",
        "operationId": "probeMedia",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProbeRequest"
              },
              "examples": {
                "default": {
                  "value": {
                    "path": "/absolute/path/to/video.mp4"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Probe metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request path",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Probe failed to inspect media",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal IO failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Unexpected probe output",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "ProbeRequest": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute local filesystem path to media file."
          }
        }
      },
      "ProbeResponse": {
        "type": "object",
        "required": [
          "metadata"
        ],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/MediaMetadata"
          }
        }
      },
      "MediaMetadata": {
        "type": "object",
        "required": [
          "path",
          "duration_seconds",
          "width",
          "height",
          "format",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "format": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
